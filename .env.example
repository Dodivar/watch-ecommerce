# Copier vers `.env` ou définir ces variables sur Vercel (projet par client).
# Voir documentation/multi-client.md

SITE_ID=sauvage-watches

# Achats en ligne (Stripe) : le front n’affiche les boutons « Acheter » que si cette valeur
# n’est pas la chaîne exacte `false` ET si `features.purchase` est true dans sites/<SITE_ID>/site.config.js
VITE_PURCHASE_ENABLED=true

# Frontend ↔ Supabase (public)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Redimensionnement images Storage (/render/image/) — Pro+ uniquement ; laisser commenté sur le plan gratuit
# VITE_SUPABASE_IMAGE_TRANSFORMS=true
# SUPABASE_SERVICE_ROLE_KEY=  # scripts maintenance (ex. npm run db:strip-case-size-mm, npm run images:reencode:apply)

# URL du backend Express (checkout Stripe, formulaires, etc.) — obligatoire en prod / GitHub Pages
# Prod Render : https://watch-ecommerce-mp9l.onrender.com
# Local : http://localhost:3000
# VITE_BACKEND_URL=
# Alternative au build : sites/<SITE_ID>/site.config.js → backend.publicApiUrl

# URL canonique du site (optionnel ; sinon déduction VERCEL_* / site.config.js)
# VITE_BASE_URL=http://localhost:5173

# Mesure et attribution (tous optionnels ; une valeur vide désactive la destination)
# GA4 — événements e-commerce du tunnel (view_item, add_to_cart, begin_checkout, purchase)
# VITE_GA_ID=
# Google Ads — tag de conversion sur l'achat. Les deux valeurs sont nécessaires :
# l'identifiant du compte ET le libellé de l'action de conversion « achat ».
# VITE_GOOGLE_ADS_ID=AW-000000000
# VITE_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel (Facebook / Instagram) — identifiant numérique du pixel
# VITE_META_PIXEL_ID=
# Ads et Meta ne se chargent qu'avec le consentement « publicité » du bandeau cookies.

# Google Maps : carte boutique (Contact / À propos) + autocomplétion adresse checkout
# APIs : Maps JavaScript API, Places API, Places API (New) — restreindre la clé par référent HTTP
# VITE_GOOGLE_PLACES_API_KEY=
