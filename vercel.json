{
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/fr/:path*",
            "destination": "/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/sitemap.js": {
            "maxDuration": 10
        }
    }
}
