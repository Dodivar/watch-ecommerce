{
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/fr/:path*",
            "destination": "/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/version.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "functions": {
        "api/sitemap.js": {
            "maxDuration": 10
        }
    }
}
