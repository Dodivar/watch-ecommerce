{
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "dist",
    "regions": [
        "dub1"
    ],
    "redirects": [
        {
            "source": "/fr/:path*",
            "destination": "/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/montre/:key",
            "destination": "/api/render-page?__route=montre&__key=:key"
        },
        {
            "source": "/watch/:key",
            "destination": "/api/render-page?__route=watch-legacy&__key=:key"
        },
        {
            "source": "/collection/:key",
            "destination": "/api/render-page?__route=collection&__key=:key"
        },
        {
            "source": "/blog/:key",
            "destination": "/api/render-page?__route=blog&__key=:key"
        },
        {
            "source": "/:lc([a-z]{2})/montre/:key",
            "destination": "/api/render-page?__route=montre&__key=:key&__lc=:lc"
        },
        {
            "source": "/:lc([a-z]{2})/watch/:key",
            "destination": "/api/render-page?__route=watch-legacy&__key=:key&__lc=:lc"
        },
        {
            "source": "/:lc([a-z]{2})/collection/:key",
            "destination": "/api/render-page?__route=collection&__key=:key&__lc=:lc"
        },
        {
            "source": "/:lc([a-z]{2})/blog/:key",
            "destination": "/api/render-page?__route=blog&__key=:key&__lc=:lc"
        },
        {
            "source": "/(.*)",
            "destination": "/spa-fallback.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/version.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "functions": {
        "api/sitemap.js": {
            "maxDuration": 10
        },
        "api/render-page.js": {
            "maxDuration": 10,
            "includeFiles": "dist/spa-fallback.html"
        }
    }
}
