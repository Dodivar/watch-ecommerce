{
  "name": "watch-ecommerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config vite/vite.config.mjs",
    "build": "vite build --config vite/vite.config.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "preview": "vite preview --config vite/vite.config.mjs",
    "dev:sauvage": "cross-env SITE_ID=sauvage-watches vite --config vite/vite.config.mjs",
    "build:sauvage": "cross-env SITE_ID=sauvage-watches vite build --config vite/vite.config.mjs",
    "build:demo-store": "cross-env SITE_ID=demo-store vite build --config vite/vite.config.mjs",
    "dev:jackned": "cross-env SITE_ID=jackned vite --config vite/vite.config.mjs",
    "build:jackned": "cross-env SITE_ID=jackned vite build --config vite/vite.config.mjs",
    "dev:place": "cross-env SITE_ID=place-des-montres vite --config vite/vite.config.mjs",
    "build:place": "cross-env SITE_ID=place-des-montres vite build --config vite/vite.config.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write packages/base/src/",
    "server": "node backend/server.js",
    "db:strip-case-size-mm": "node scripts/strip-case-size-mm.mjs",
    "db:strip-case-size-mm:apply": "node scripts/strip-case-size-mm.mjs --apply",
    "db:import-prestashop": "node scripts/prestashop-import/import-prestashop-catalog.mjs",
    "db:import-prestashop:apply": "node scripts/prestashop-import/import-prestashop-catalog.mjs --apply",
    "db:prestashop-spike": "node scripts/prestashop-import/spike-normalization-report.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run packages/base/src/site",
    "test:contracts": "vitest run tests/contracts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@lucide/vue": "^1.16.0",
    "@stripe/stripe-js": "^5.10.0",
    "@supabase/supabase-js": "^2.83.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueform/slider": "^2.1.10",
    "@vuepic/vue-datepicker": "^13.0.0",
    "@vueuse/head": "^2.0.0",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "marked": "^17.0.1",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.2.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.35",
    "prettier": "3.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.1.7"
  }
}
