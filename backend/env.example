# =============================================================================
# Backend multi-tenant — variables d'environnement
# =============================================================================
#
# URL de production Render : https://watch-ecommerce-mp9l.onrender.com
# Webhooks Stripe : https://watch-ecommerce-mp9l.onrender.com/api/stripe/webhook/<site-id>
#
# Le backend Render unique aiguille chaque requête vers la configuration du
# bon client à partir de l'Origin (ou du paramètre URL pour les webhooks Stripe).
# Tous les secrets sont préfixés `SITE_<UPPER_SITE_ID>__<KEY>`.
#
# Pour Sauvage Watches : SITE_SAUVAGE_WATCHES__*
# Pour un nouveau client (kebab-case)  : SITE_<UPPER_SNAKE_CASE>__*
#
# Rétrocompatibilité : si une variable préfixée est absente pour Sauvage,
# le serveur retombe sur la variable historique (sans préfixe) en émettant
# un warning au démarrage. Cette compat sera retirée à terme.
# =============================================================================


# -----------------------------------------------------------------------------
# Configuration serveur (globale)
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# CORS : origines additionnelles globales (CSV). Les origines déclarées dans
# `sites/<id>/site.config.js` (urls.production / urls.staging / urls.development
# + leur variante `www.`) sont déjà autorisées automatiquement.
# BACKEND_CORS_ORIGINS=https://exemple1.com,https://exemple2.com

# Site par défaut en dev quand l'Origin ne matche aucun site connu (utile pour curl).
# DEV_DEFAULT_SITE_ID=sauvage-watches


# -----------------------------------------------------------------------------
# Supervision (globale, non préfixée par site)
# -----------------------------------------------------------------------------
# Jeton obligatoire pour /api/health/deep et /api/health/payments. Sans lui, les
# deux routes répondent 503 `disabled` : la supervision est fermée par défaut.
# Générer une valeur longue et aléatoire, ex. `openssl rand -hex 32`, et la
# déclarer aussi côté moniteur (UptimeRobot / Better Stack) et dans les secrets
# GitHub Actions (workflow `monitoring.yml`).
# HEALTH_CHECK_TOKEN=

# Sites réellement en production, en CSV (ex. `sauvage-watches,place-des-montres`).
# Pour eux, un secret manquant est traité comme une PANNE et non comme un
# « site non configuré » : sans cette liste, une variable Supabase ou Stripe
# effacée par erreur des variables Render laisserait la supervision au vert
# pendant que la boutique est morte. Les autres sites (démo, client pas encore
# lancé) restent neutres.
# HEALTH_REQUIRED_SITES=sauvage-watches,place-des-montres

# Durée de mémoïsation du check profond (défaut 60 000 ms). Plusieurs moniteurs
# et régions se partagent ainsi un seul aller-retour réel vers les tiers :
# l'egress Supabase est compté sur le plan Free.
# HEALTH_CACHE_TTL_MS=60000

# Timeout par sonde (défaut 5 000 ms) : un tiers qui ne répond pas doit échouer
# vite, pas retenir la requête de monitoring.
# HEALTH_PROBE_TIMEOUT_MS=5000

# Invariant paiements : mémoïsation (défaut 300 000 ms) et fenêtre d'analyse en
# minutes (défaut 90). La fenêtre doit couvrir l'intervalle entre deux passages
# du moniteur, sinon un paiement orphelin peut passer entre les mailles.
# HEALTH_PAYMENTS_TTL_MS=300000
# HEALTH_PAYMENTS_WINDOW_MINUTES=90

# Débit maximal par IP et par minute sur les routes de supervision (défaut 30).
# HEALTH_RATE_LIMIT_MAX=30


# -----------------------------------------------------------------------------
# Avis Google (globale) — voir documentation/google-reviews.md
# -----------------------------------------------------------------------------
# Durée de mise en cache des avis d'une fiche (défaut 6 h). C'est ce cache qui rend la
# fonctionnalité gratuite : le champ `reviews` de Places API est facturé à l'appel, un cache
# de 6 h ramène la consommation à ~4 appels par jour et par site. Les CGU Google plafonnent la
# mise en cache du contenu Places à 30 jours — ne pas dépasser 2592000000.
# REVIEWS_CACHE_TTL_MS=21600000

# Timeout de l'appel Places (défaut 5 000 ms) et débit max par IP et par minute (défaut 60).
# REVIEWS_TIMEOUT_MS=5000
# REVIEWS_RATE_LIMIT_MAX=60


# =============================================================================
# Site : Sauvage Watches
# =============================================================================

# --- Stripe ---
SITE_SAUVAGE_WATCHES__STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
SITE_SAUVAGE_WATCHES__STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optionnel — limite API checkout/commandes par IP (fenêtre 15 min). Défaut 30.
# SITE_SAUVAGE_WATCHES__STRIPE_CHECKOUT_RATE_LIMIT_MAX=30

# --- Supabase ---
SITE_SAUVAGE_WATCHES__SUPABASE_URL=https://your-project.supabase.co
SITE_SAUVAGE_WATCHES__SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Mailjet ---
SITE_SAUVAGE_WATCHES__MAILJET_API_KEY=your_mailjet_api_key_here
SITE_SAUVAGE_WATCHES__MAILJET_SECRET_KEY=your_mailjet_secret_key_here

# --- Mesure GA4 côté serveur (optionnel) ---
# Remonte l'achat à GA4 depuis le webhook Stripe, pour ne pas perdre les ventes où le client
# ne revient jamais sur la page de confirmation. Même `transaction_id` que l'envoi navigateur :
# GA4 dédoublonne. Sans ces deux valeurs, l'envoi serveur est simplement ignoré.
# Le secret se crée dans GA4 → Admin → Flux de données → Protocole de mesure.
# SITE_SAUVAGE_WATCHES__GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# SITE_SAUVAGE_WATCHES__GA4_API_SECRET=your_ga4_measurement_protocol_secret

# --- Avis Google (optionnel) ---
# Clé Google Cloud SERVEUR, distincte de la clé front `VITE_GOOGLE_PLACES_API_KEY` : cette
# dernière est restreinte par référent HTTP et ne fonctionne pas depuis Render. Créer une clé
# dédiée restreinte par adresse IP, limitée à « Places API (New) ».
# Sans elle, /api/reviews répond 503 et la section d'avis reste simplement masquée.
# SITE_SAUVAGE_WATCHES__GOOGLE_PLACES_API_KEY=

# --- Sécurité paiement ---
SITE_SAUVAGE_WATCHES__PAYMENT_CANCEL_SECRET=generate_a_long_random_secret

# Optionnel — override du BASE_URL frontend (sinon urls.production du manifest).
# SITE_SAUVAGE_WATCHES__BASE_URL=https://sauvage-watches.fr

# Optionnel — override de l'adresse `From` Mailjet (sinon site.config.backend.email.fromAddress).
# SITE_SAUVAGE_WATCHES__EMAIL_FROM=contact@sauvage-watches.fr


# =============================================================================
# Site : Demo Store (modèle pour ajouter un nouveau client)
# =============================================================================
# SITE_DEMO_STORE__STRIPE_SECRET_KEY=sk_...
# SITE_DEMO_STORE__STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_DEMO_STORE__SUPABASE_URL=https://...supabase.co
# SITE_DEMO_STORE__SUPABASE_SERVICE_ROLE_KEY=...
# SITE_DEMO_STORE__MAILJET_API_KEY=...
# SITE_DEMO_STORE__MAILJET_SECRET_KEY=...
# SITE_DEMO_STORE__PAYMENT_CANCEL_SECRET=...


# =============================================================================
# Site : Jack'N'Ed (jackned — même convention que tout siteId kebab-case)
# =============================================================================
# SITE_JACKNED__STRIPE_SECRET_KEY=sk_...
# SITE_JACKNED__STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_JACKNED__SUPABASE_URL=https://...supabase.co
# SITE_JACKNED__SUPABASE_SERVICE_ROLE_KEY=...
# SITE_JACKNED__MAILJET_API_KEY=...
# SITE_JACKNED__MAILJET_SECRET_KEY=...
# SITE_JACKNED__PAYMENT_CANCEL_SECRET=...
# SITE_JACKNED__GOOGLE_PLACES_API_KEY=
# SITE_JACKNED__BASE_URL=https://www.jackned.com


# =============================================================================
# Variables historiques (LEGACY — Sauvage uniquement, à migrer)
# =============================================================================
# Tant que `SITE_SAUVAGE_WATCHES__*` n'est pas défini, ces variables servent
# de fallback pour le site `sauvage-watches`. À supprimer après migration.
#
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# EMAIL_FROM=contact@sauvage-watches.fr
# BASE_URL=https://sauvage-watches.fr
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENT_CANCEL_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# N8N_WORKFLOW_URL=
